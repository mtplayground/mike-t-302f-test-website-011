---
import Community from '../components/sections/Community.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import Hero from '../components/sections/Hero.astro';
import ProductPreview from '../components/sections/ProductPreview.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = siteConfig.name;
---

<BaseLayout title={pageTitle} description={siteConfig.description}>
  <Hero />
  <ProductPreview />
  <FeatureGrid />
  <Community />
</BaseLayout>
