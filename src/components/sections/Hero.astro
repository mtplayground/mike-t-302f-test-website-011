---
import SectionShell from '../SectionShell.astro';
import { siteConfig } from '../../config/site';

const { assets, ctas } = siteConfig;
const heroCopy =
  "myClawTeam — Agent Team for Founders. You just talk, we handle the rest. myClawTeam is the GitHub-native AI engineering team that turns founders' ideas into production-ready, secure software by autonomously handling the full Software Development Lifecycle (SDLC) — you just talk, and the agent team manages planning, building, deploying, and operating while you keep complete code ownership in your own repository.";
---

<SectionShell
  id="intro"
  labelledBy="hero-heading"
  class="min-h-[calc(100vh-5rem)] overflow-hidden bg-[linear-gradient(145deg,rgba(249,115,22,0.16)_0%,rgba(16,17,22,0.98)_38%,rgba(9,10,13,1)_100%)]"
>
  <div class="flex min-h-[calc(100vh-15rem)] flex-col justify-center py-8">
    <div class="max-w-4xl space-y-8">
      <img
        src={assets.logo}
        alt={`${siteConfig.name} logo`}
        width="280"
        height="64"
        class="h-12 w-auto"
      />

      <div class="space-y-5">
        <p class="text-eyebrow font-semibold uppercase text-accent-400">
          Agent Team for Founders
        </p>
        <h1
          id="hero-heading"
          class="max-w-4xl font-display text-display-sm font-semibold text-ink-50 md:text-display"
        >
          <span class="block">Agent Team for Founders</span>
          <span class="block text-ink-200">
            You just talk, we handle the rest
          </span>
        </h1>
      </div>

      <p class="max-w-3xl text-lead text-ink-300">{heroCopy}</p>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={ctas.primary.href}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-accent-500 px-6 text-sm font-semibold text-ink-950 no-underline shadow-glow transition-colors hover:bg-accent-400 hover:text-ink-950"
        >
          <span>{ctas.primary.label}</span>
          <img
            src={assets.icons.arrowRight}
            alt=""
            width="18"
            height="18"
            class="h-4 w-4"
          />
        </a>
        <a
          href={ctas.secondary.href}
          class="inline-flex h-12 items-center justify-center rounded-md border border-border/15 bg-surface-raised/80 px-6 text-sm font-semibold text-ink-100 no-underline transition-colors hover:border-accent-500/50 hover:bg-surface-elevated hover:text-ink-50"
        >
          {ctas.secondary.label}
        </a>
      </div>
    </div>
  </div>
</SectionShell>
