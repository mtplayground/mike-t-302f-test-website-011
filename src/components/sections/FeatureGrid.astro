---
import SectionShell from '../SectionShell.astro';
import { siteConfig } from '../../config/site';

const { features } = siteConfig;
---

<SectionShell id="features" labelledBy="features-heading" class="bg-ink-950">
  <div class="space-y-10">
    <div class="max-w-3xl space-y-4">
      <p class="text-eyebrow font-semibold uppercase text-accent-400">
        {features.eyebrow}
      </p>
      <h2
        id="features-heading"
        class="font-display text-3xl font-semibold text-ink-50 sm:text-display-sm"
      >
        {features.heading}
      </h2>
      <p class="text-lead text-ink-300">{features.subtext}</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        features.cards.map((feature) => (
          <article class="rounded-lg border border-border/10 bg-surface-raised p-6 shadow-panel">
            <div class="flex h-12 w-12 items-center justify-center rounded-md border border-accent-500/20 bg-accent-500/10">
              <img
                src={feature.icon}
                alt=""
                width="28"
                height="28"
                class="h-7 w-7"
              />
            </div>
            <div class="mt-6 space-y-3">
              <h3 class="text-lg font-semibold text-ink-50">{feature.title}</h3>
              <p class="text-sm leading-6 text-ink-400">{feature.blurb}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</SectionShell>
